From: V6lhost <v6lhost@proton.me>
Subject: [PATCH 0083] SETUP: relax compiler flags for host tools on Xcode 16

--- a/osfmk/kern/Makefile.template
+++ b/osfmk/kern/Makefile.template
@@ -1,3 +1,6 @@
+# Relax strict errors for modern host compilers
+HOST_CFLAGS += -Wno-error -Wno-implicit-function-declaration -Wno-deprecated-declarations
+
 #
 # Copyright (c) 2000-2007 Apple Inc. All rights reserved.
 #
--- a/SETUP/config/Makefile.in
+++ b/SETUP/config/Makefile.in
@@ -1,3 +1,5 @@
+CFLAGS += -Wno-error -Wno-implicit-function-declaration -Wno-deprecated-declarations
+
 #
 # Copyright (c) 2000-2007 Apple Inc. All rights reserved.
 #
