+void
+native_owner_root_panic_summary(char *buffer, size_t size)
+{
+#if defined(XNU_OWNER_ROOT_AUDIT) && XNU_OWNER_ROOT_AUDIT
+	extern void native_owner_root_summary(char *, size_t)
+	    __attribute__((weak));
+	int written;
+
+	if ((buffer == NULL) || (size == 0u)) {
+		return;
+	}
+	written = snprintf(buffer, size,
+	    "owner-root: trust=%u apple=%d decision=%d accepted=%u ro=%d "
+	    "mdev=%x sdev=%x",
+	    (unsigned)native_owner_root_trust_enabled,
+	    native_owner_root_apple_autherr,
+	    native_owner_root_decision,
+	    (unsigned)native_owner_root_accepted,
+	    native_owner_root_readonly,
+	    (unsigned)native_owner_root_mount_device,
+	    (unsigned)native_owner_root_selected_device);
+	if ((written < 0) || ((size_t)written >= size)) {
+		return;
+	}
+	if (native_owner_root_summary != NULL) {
+		if ((size_t)written + 2u < size) {
+			buffer[written] = ' ';
+			native_owner_root_summary(&buffer[written + 1],
+			    size - (size_t)written - 1u);
+		}
+	} else {
+		(void)snprintf(&buffer[written], size - (size_t)written,
+		    " drv=none");
+	}
+#else
+	if ((buffer == NULL) || (size == 0u)) {
+		return;
+	}
+	(void)snprintf(buffer, size, "owner-root: unavailable");
+#endif
+}
