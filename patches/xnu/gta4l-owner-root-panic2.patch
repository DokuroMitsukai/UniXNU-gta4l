+static int
+gta4l_proc_named(const char *name)
+{
+	proc_t p;
+	int found = 0;
+
+	proc_list_lock();
+	ALLPROC_FOREACH(p) {
+		if (p->p_stat == SIDL || proc_is_shadow(p)) {
+			continue;
+		}
+		if (strcmp(p->p_name, name) == 0) {
+			found = 1;
+			break;
+		}
+	}
+	proc_list_unlock();
+	return found;
+}
+
+static int
+gta4l_proc_pid_named(const char *name)
+{
+	proc_t p;
+	int pid = -1;
+
+	proc_list_lock();
+	ALLPROC_FOREACH(p) {
+		if (p->p_stat == SIDL || proc_is_shadow(p)) {
+			continue;
+		}
+		if (strcmp(p->p_name, name) == 0) {
+			pid = proc_getpid(p);
+			break;
+		}
+	}
+	proc_list_unlock();
+	return pid;
+}
