+gta4l_leading_name(struct gta4l_exit_top *table, int used, char *out,
+    size_t size)
+{
+	uint64_t count = 0;
+	const char *name = "none";
+	int i;
+
+	for (i = 0; i < used; i++) {
+		if (table[i].count > count) {
+			count = table[i].count;
+			name = table[i].name;
+		}
+	}
+	snprintf(out, size, "%.12s/%llu", name,
+	    (unsigned long long)count);
+}
+
+static void
+gta4l_format_top3(char *out, size_t size)
+{
+	struct gta4l_exit_top sorted[GTA4L_EXIT_TOP];
+	size_t pos = 0;
+	int i, j, n = gta4l_abn_top_count;
+
+	if (n > GTA4L_EXIT_TOP) {
+		n = GTA4L_EXIT_TOP;
+	}
+	for (i = 0; i < n; i++) {
+		sorted[i] = gta4l_abn_top[i];
+	}
+	for (i = 0; i < n; i++) {
+		for (j = i + 1; j < n; j++) {
+			if (sorted[j].count > sorted[i].count) {
+				struct gta4l_exit_top tmp = sorted[i];
+
+				sorted[i] = sorted[j];
+				sorted[j] = tmp;
+			}
+		}
+	}
+	if (n == 0) {
+		strlcpy(out, "none/0", size);
+		return;
+	}
+	for (i = 0; i < n && i < 3; i++) {
+		pos += snprintf(out + pos, size - pos, "%s%.12s/%llu",
+		    i ? ";" : "", sorted[i].name,
+		    (unsigned long long)sorted[i].count);
+		if (pos >= size) {
+			break;
+		}
+	}
+}
