+/* Remember the most frequent names without allocating: replace the least
+ * frequent slot when full. Diagnostics only; a lost update under concurrent
+ * exits is acceptable. */
+static void
+gta4l_note_top(struct gta4l_exit_top *table, int *used, int capacity,
+    const char *name)
+{
+	int i, smallest;
+
+	for (i = 0; i < *used; i++) {
+		if (strcmp(table[i].name, name) == 0) {
+			table[i].count++;
+			return;
+		}
+	}
+	if (*used < capacity) {
+		i = (*used)++;
+	} else {
+		smallest = 0;
+		for (i = 1; i < capacity; i++) {
+			if (table[i].count < table[smallest].count) {
+				smallest = i;
+			}
+		}
+		i = smallest;
+	}
+	strlcpy(table[i].name, name, sizeof(table[i].name));
+	table[i].count = 1;
+}
+
+static void
+gta4l_note_abnormal(int pid, const char *name, int status, int ns,
+    uint64_t code, const char *desc)
+{
+	int last;
+
+	gta4l_note_top(gta4l_abn_top, &gta4l_abn_top_count, GTA4L_EXIT_TOP,
+	    name);
+	if (ns == 8) {
+		size_t n, i;
+
+		gta4l_note_top(gta4l_objc_top, &gta4l_objc_top_count,
+		    GTA4L_NAME_TOP, name);
+		n = (desc != NULL) ? strnlen(desc, GTA4L_DESC_MAX) : 0;
+		if (n == 0) {
+			strlcpy(gta4l_objc_desc, "none",
+			    sizeof(gta4l_objc_desc));
+		} else {
+			for (i = 0; i < n; i++) {
+				unsigned char c = (unsigned char)desc[i];
+
+				gta4l_objc_desc[i] =
+				    (c >= 0x20 && c < 0x7f) ? (char)c : '.';
+			}
+			gta4l_objc_desc[n] = '\0';
+		}
+	} else if (ns == 2) {
+		gta4l_note_top(gta4l_sig_top, &gta4l_sig_top_count,
+		    GTA4L_NAME_TOP, name);
+	}
+
+	/* Coalesce repeats of the newest name so the four slots show variety. */
+	if (gta4l_abn_seen_count > 0) {
+		last = (gta4l_abn_seen_next + GTA4L_EXIT_RING - 1) %
+		    GTA4L_EXIT_RING;
+		if (strcmp(gta4l_abn_seen[last].name, name) == 0) {
+			gta4l_abn_seen[last].pid = pid;
+			gta4l_abn_seen[last].status = status;
+			gta4l_abn_seen[last].ns = ns;
+			gta4l_abn_seen[last].code = code;
+			return;
+		}
+	}
+	{
+		struct gta4l_exit_seen *slot =
+		    &gta4l_abn_seen[gta4l_abn_seen_next];
+
+		strlcpy(slot->name, name, sizeof(slot->name));
+		slot->pid = pid;
+		slot->status = status;
+		slot->ns = ns;
+		slot->code = code;
+		gta4l_abn_seen_next = (gta4l_abn_seen_next + 1) %
+		    GTA4L_EXIT_RING;
+		if (gta4l_abn_seen_count < GTA4L_EXIT_RING) {
+			gta4l_abn_seen_count++;
+		}
+	}
+}
 
