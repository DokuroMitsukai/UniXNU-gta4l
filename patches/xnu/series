# Board XNU patches, in application order.
# Shared patches come from the ARM64, SM6115 and OS profiles; board-specific
# patches stay in this repository.

# Board opt-in PMGR bridge hook; paired with CONFIG_XNU_SHENG_PMGR and build-platform-power.py.
sheng-platform-power.patch

# Board-only observation probe hook; the probe returns unless the matching boot argument is present.
gta4l-sdhci-snapshot.patch

# Board-only handoff audit and host-local init hooks; both return unless the matching boot argument is present.
gta4l-sdhci-handoff-audit.patch

# Board-only eMMC diagnostic hook; returns unless gta4l-emmc-probe=1 is present.
gta4l-emmc-probe.patch

# Board-only read-only block publication personality. The guard is inert until
# the shared build script translates CONFIG_XNU_NATIVE_GTA4L_EMMC_BLOCK.
gta4l-emmc-block.patch

# Board-only panic summary for the verified-root verdict. Temporary: fold into
# the shared owner-root patch after all boot work is finished.
gta4l-owner-root-panic.patch

# Board-only diagnostic suffix for the initproc failed-to-start and deadline
# panics: the last native-4K preparation result, shared-region map
# attempt/result/carrier counts, uptime, the pre-read read/hash tick split,
# exec/exit activity with the last exiting process and the last four distinct
# names, per-namespace exit counts, the most frequent exiting name, the Data
# volume free space, free/wired pages and key daemon presence. Printing only.
gta4l-owner-root-panic2.patch
